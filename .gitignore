.DS_Store
.venv/
__pycache__/
*.pyc
*.pem
*.key
*.p12
.env
.env.*
codex-logs/runs/
codex-logs/codex-home/
codex-logs/system.log
codex-memory/.hf-cache/
codex-memory/memory.db
codex-memory/context.md
codex-memory/decisions.md
codex-memory/tasks.log
status.txt
# Queue dispatch entries are runtime state, not source.
# Git-tracking them causes the recurring pipeline stall (v23,v24,v29,v30,v31)
# because git operations reset queues/*.txt to empty committed state.
queues/*.txt
!queues/.gitkeep
projects/superheld/repo/
.codex-agent/cra-compliance.json
.codex-tmp-*.js
.codex/automations/*/memory.md
.codex/
